            "header": [
              { "key": "Accept", "value": "application/json", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Renamed document title\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{apiUrl}}/documents/{{documentId}}"
          }
        },
        {
          "name": "Delete Document",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Accept", "value": "application/json", "type": "text" }],
            "url": "{{apiUrl}}/documents/{{documentId}}"
          }
        },
        {
          "name": "Attach Document to Case",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"case_id\": \"{{caseId}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{apiUrl}}/documents/{{documentId}}/attach"
          }
        }
      ]
    },
