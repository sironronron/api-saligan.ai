            "url": "{{apiUrl}}/conversations/{{conversationId}}/messages",
            "description": "Returns a Server-Sent Events stream: `event: delta`, `event: tool_call`, `event: done`, etc. Prefix a message with `[Template: <uuid|subtype>]` to force a template, or start with `[Intake Form Submission]` to submit intake answers."
          }
