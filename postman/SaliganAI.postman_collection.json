    {
      "name": "Cases",
      "description": "Requires an authenticated session and an active subscription.",
      "item": [
        {
          "name": "List Cases",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json", "type": "text" }],
            "url": {
              "raw": "{{apiUrl}}/cases?status=open&case_type=legal",
              "host": ["{{apiUrl}}"],
              "path": ["cases"],
              "query": [
                { "key": "status", "value": "open", "disabled": true },
                { "key": "case_type", "value": "legal", "disabled": true }
              ]
            },
            "description": "Optional query params: status, case_type, priority, search."
          }
        },
        {
          "name": "Create Case",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Nexbyte vs Marisol - unpaid demand\",\n  \"case_type\": \"legal\",\n  \"priority\": \"high\",\n  \"status\": \"open\",\n  \"description\": \"NEXBYTE delivered inventory management software to Marisol Retail Group but the PHP 855,000 invoice remains unpaid beyond the agreed 30-day term.\",\n  \"related_parties\": [\"NEXBYTE SOLUTIONS, INC (claimant)\", \"Marisol Retail Group, Inc. (debtor)\"],\n  \"due_date\": \"2026-09-15\",\n  \"tags\": [\"debt\", \"collections\"],\n  \"default_template_id\": null\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{apiUrl}}/cases"
          }
        },
        {
          "name": "Show Case",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json", "type": "text" }],
            "url": "{{apiUrl}}/cases/{{caseId}}"
          }
        },
        {
          "name": "Update Case",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Accept", "value": "application/json", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Nexbyte vs Marisol - unpaid demand\",\n  \"status\": \"in_progress\",\n  \"priority\": \"urgent\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{apiUrl}}/cases/{{caseId}}"
          }
        },
        {
          "name": "Delete Case",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Accept", "value": "application/json", "type": "text" }],
            "url": "{{apiUrl}}/cases/{{caseId}}",
            "description": "Soft-delete the case."
          }
        },
        {
          "name": "Create Case Conversation",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"purpose\": \"Draft a letter\",\n  \"title\": \"Draft a letter\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{apiUrl}}/cases/{{caseId}}/conversations"
          }
        },
        {
          "name": "Duplicate Case",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json", "type": "text" }],
            "url": "{{apiUrl}}/cases/{{caseId}}/duplicate"
          }
        },
        {
          "name": "Restore Case",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json", "type": "text" }],
            "url": "{{apiUrl}}/cases/{{caseId}}/restore"
