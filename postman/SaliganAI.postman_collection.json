    {
      "name": "Admin",
      "description": "Requires an authenticated **admin** session.",
      "item": [
        {
          "name": "List Legal Sources",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json", "type": "text" }],
            "url": "{{apiUrl}}/admin/legal-sources"
          }
        },
        {
          "name": "Create Legal Source",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Official Gazette\",\n  \"base_domain\": \"officialgazette.gov.ph\",\n  \"seed_urls\": [\"https://www.officialgazette.gov.ph/laws/\"],\n  \"is_active\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{apiUrl}}/admin/legal-sources"
          }
        },
        {
          "name": "Delete Legal Source",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Accept", "value": "application/json", "type": "text" }],
            "url": "{{apiUrl}}/admin/legal-sources/{{legalSourceId}}"
          }
        },
        {
          "name": "Crawl Legal Source Now",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json", "type": "text" }],
            "url": "{{apiUrl}}/admin/legal-sources/{{legalSourceId}}/crawl-now"
          }
        },
        {
          "name": "List Crawled Pages",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json", "type": "text" }],
            "url": "{{apiUrl}}/admin/crawled-pages"
          }
        },
        {
          "name": "List System Prompts",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json", "type": "text" }],
            "url": "{{apiUrl}}/admin/system-prompts"
          }
        },
        {
          "name": "Create System Prompt",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Saligan Assistant v3\",\n  \"content\": \"You are Saligan, a Philippine legal research assistant. ...\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{apiUrl}}/admin/system-prompts",
            "description": "Creates a new version; the new version starts inactive."
          }
        },
        {
          "name": "Activate System Prompt",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json", "type": "text" }],
            "url": "{{apiUrl}}/admin/system-prompts/{{systemPromptId}}/activate",
            "description": "Deactivates the other versions of the same prompt name and activates this one."
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8000" },
    { "key": "apiUrl", "value": "{{baseUrl}}/api" },
    { "key": "caseId", "value": "" },
    { "key": "conversationId", "value": "" },
    { "key": "documentId", "value": "" },
    { "key": "messageId", "value": "" },
    { "key": "todoId", "value": "" },
    { "key": "templateId", "value": "" },
    { "key": "planId", "value": "" },
    { "key": "legalSourceId", "value": "" },
    { "key": "systemPromptId", "value": "" }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Attach the session's CSRF token to state-changing requests.",
          "// The XSRF-TOKEN cookie is set by GET /sanctum/csrf-cookie.",
          "const method = pm.request.method.toUpperCase();",
          "",
          "pm.request.headers.upsert({ key: 'Accept', value: 'application/json' });",
          "",
          "if (!['GET', 'HEAD', 'OPTIONS'].includes(method)) {",
          "  const token = pm.cookies.get('XSRF-TOKEN');",
          "  if (token) {",
          "    pm.request.headers.upsert({",
          "      key: 'X-XSRF-TOKEN',",
          "      value: decodeURIComponent(token),",
          "    });",
          "  }",
          "}"
        ]
      }
    }
  ]
}
