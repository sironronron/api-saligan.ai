    {
      "name": "Documents",
      "description": "Requires an authenticated session and an active subscription.",
      "item": [
        {
          "name": "List Documents",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json", "type": "text" }],
            "url": {
              "raw": "{{apiUrl}}/documents?case_id={{caseId}}",
              "host": ["{{apiUrl}}"],
              "path": ["documents"],
              "query": [{ "key": "case_id", "value": "{{caseId}}", "disabled": true }]
            },
            "description": "Pass `case_id` to list only the documents attached to a case."
          }
        },
        {
          "name": "Upload Document",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json", "type": "text" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": [], "description": "PDF, DOCX, TXT, MD, or image (OCR)" },
                { "key": "title", "value": "Contract of Lease", "type": "text" },
                { "key": "case_id", "value": "{{caseId}}", "type": "text" }
              ]
            },
            "url": "{{apiUrl}}/documents",
            "description": "Multipart upload. The document is queued and processed asynchronously (status: queued → processing → ready/failed)."
          }
        },
        {
          "name": "Show Document",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json", "type": "text" }],
            "url": "{{apiUrl}}/documents/{{documentId}}"
          }
        },
