APP_NAME="Saligan.AI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@saligan.ai"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://meilisearch:7700

MEILISEARCH_NO_ANALYTICS=false

# ============================================================================
# Saligan.AI — Legal RAG
# ============================================================================

# Frontend origin (Nuxt dev server); must be listed for Sanctum SPA auth + CORS
FRONTEND_URL=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost:3000

# Ollama (local)
OLLAMA_URL=http://192.168.1.101:11434
OLLAMA_API_KEY=
OLLAMA_CHAT_MODEL=qwen3.6:latest
OLLAMA_CHAT_MODEL_ALT=qwen3.5:latest
OLLAMA_EMBED_MODEL=qwen3-embedding:latest
EMBEDDING_DIMENSIONS=4000

# Gemini (secondary, manual per-conversation toggle)
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.6-flash

# Provider routing
AI_CHAT_PROVIDER=ollama
AI_EMBED_PROVIDER=ollama

# Document processing
DOCUMENT_MAX_SIZE_MB=25
DOCUMENT_CHUNK_SIZE=500
DOCUMENT_CHUNK_OVERLAP=50
DOCUMENT_PROCESSING_QUEUE=document-processing

# Legal source crawler
LEGAL_CRAWLER_ENABLED=true
LEGAL_CRAWLER_SCHEDULE="0 2 * * *"
LEGAL_CRAWLER_USER_AGENT="SaliganAIBot/1.0 (+https://saligan.ai/bot)"
LEGAL_CRAWLER_DELAY_MS=3000
LEGAL_CRAWLER_QUEUE=legal-crawler
